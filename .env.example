# Copy to .env.local and fill in.
DATABASE_PATH=./data/ledger.db
UPLOADS_DIR=./uploads

# Where the Backup button writes zips. Point it at a cloud-synced folder.
BACKUP_DIR=

# Gmail: create an app password at https://myaccount.google.com/apppasswords (requires 2-Step Verification).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
