{
  "name": "ledger",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "start:app": "npm run db:migrate && next build && next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
