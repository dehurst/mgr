# Copy to .env.local and fill in. On the Mac only DATABASE_PATH / UPLOADS_DIR matter.
DATABASE_PATH=./data/ledger.db
UPLOADS_DIR=./uploads

# ---- Online (set these in Vercel → Project → Settings → Environment Variables) ----
# Turso database (or TURSO_DATABASE_URL / TURSO_AUTH_TOKEN from Vercel's Turso integration)
# DATABASE_URL=libsql://ledger-<you>.turso.io
# DATABASE_AUTH_TOKEN=
# Private Vercel Blob store for receipts (set automatically when you connect the store)
# BLOB_READ_WRITE_TOKEN=
# Google sign-in: only ALLOWED_EMAIL may sign in
# AUTH_SECRET=            # openssl rand -base64 32
# AUTH_GOOGLE_ID=
# AUTH_GOOGLE_SECRET=
# ALLOWED_EMAIL=you@gmail.com
# Daily backup job
# CRON_SECRET=            # openssl rand -base64 32
